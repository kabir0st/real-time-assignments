{
    "version": 4,
    "configurations": [
        {
            "name": "ARM Cross-Compile",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/include",
                "${workspaceFolder}/src",
                "${workspaceFolder}/lib",
                "/usr/arm-linux-gnueabihf/include/**",
                "/usr/lib/gcc-cross/arm-linux-gnueabihf/*/include/**",
                "/usr/lib/gcc-cross/arm-linux-gnueabihf/*/include-fixed/**"
            ],
            "defines": [
                "__ARM_ARCH_7A__",
                "__ARM_NEON__",
                "__ARM_FEATURE_UNALIGNED",
                "__ARMEL__",
                "__SOFTFP__",
                "__VFP_FP__",
                "__ARM_PCS_VFP",
                "BCM2837",
                "RPI3",
                "ARM_CORTEX_A53",
                "_GNU_SOURCE",
                "__GNUC__",
                "__linux__",
                "__unix__"
            ],
            "compilerPath": "/usr/bin/arm-linux-gnueabihf-gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm",
            "compilerArgs": [
                "-mcpu=cortex-a53",
                "-mfpu=neon-fp-armv8",
                "-mfloat-abi=hard",
                "-marm",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-std=c11"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/**",
                    "/usr/arm-linux-gnueabihf/include/**",
                    "/usr/lib/gcc-cross/arm-linux-gnueabihf/*/include/**"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db"
            }
        },
        {
            "name": "Bare Metal ARM",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/include",
                "${workspaceFolder}/src",
                "${workspaceFolder}/drivers",
                "${workspaceFolder}/hal",
                "${workspaceFolder}/bsp"
            ],
            "defines": [
                "__ARM_ARCH_7A__",
                "__ARM_NEON__",
                "BCM2837",
                "RPI3",
                "BARE_METAL",
                "NO_STDLIB",
                "__CORTEX_A53__"
            ],
            "compilerPath": "/usr/bin/arm-none-eabi-gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-arm",
            "compilerArgs": [
                "-mcpu=cortex-a53",
                "-mfpu=neon-fp-armv8",
                "-mfloat-abi=hard",
                "-marm",
                "-nostdlib",
                "-nostartfiles",
                "-ffreestanding",
                "-Wall",
                "-Wextra",
                "-std=c11"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/**"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": "${workspaceFolder}/.vscode/browse_baremetal.vc.db"
            }
        }
    ]
}